pipeline {
    agent {
        label 'master'
    }

    options {
        // 禁止同一 job 并发构建:串行化"清理残留评测进程"等破坏性步骤,
        // 避免新构建误杀上一构建尚未结束的评测进程
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'TESTER', defaultValue: 'liwt', description: '测试人员名称（必填，基准评测构建目录分层 bench_builds/<tester>/<model>/<build>/，与功能验证流水线的 builds/ 互相隔离）')
        string(name: 'CHIP', defaultValue: 'nvidia-b300', description: '芯片平台名称(必填)')
        choice(name: 'ENGINE', choices: ['sglang', 'vllm'], description: '推理框架(必填,仅用于邮件展示)')
        choice(name: 'PD', choices: ['agg', 'disagg'], description: 'PD分离模式(agg=非PD分离,disagg=PD分离,仅用于邮件展示)')
        string(name: 'MODEL', defaultValue: 'kimi-k3', description: '模型服务名称（必填，即 /v1/models 返回的 id，评测时自动加 kimi/ provider 前缀）')
        string(name: 'BASE_URL', defaultValue: 'https://token-bj11.alayanew.com:26443', description: 'API 根地址（必填，不带 /v1 后缀，流水线会自动拼接，透传为环境变量 KIMI_BASE_URL）')
        password(name: 'API_KEY', defaultValue: 'EMPTY', description: 'API Key（透传为环境变量 KIMI_API_KEY；SGLang 未开启鉴权时保持 EMPTY）')

        booleanParam(name: 'RUN_OCRBENCH', defaultValue: true, description: '是否评测 OCRBench（OCRBench，文本识别基准，全量 1000 样本）')
        booleanParam(name: 'RUN_MMMU', defaultValue: true, description: '是否评测 MMMU（MMMU-Pro standard 10 options，多模态理解基准，全量约 1.17 万样本、单轮数亿 token，耗时较长，可用 LIMIT 截断）')
        booleanParam(name: 'RUN_TOOLCALL', defaultValue: true, description: '是否评测 Tool Call（kimi_toolcall，README K3 推荐表任务之一，全量 70 样本，数据集在仓库 LFS 内，经 git lfs pull 自动同步）')
        string(name: 'TOOLCALL_DATASET', defaultValue: 'toolcall_benchmark/toolcall_thinking_samples.stable2.jsonl', description: 'kimi_toolcall 数据集路径（仓库内 LFS 文件）')

        booleanParam(name: 'RUN_BEAM', defaultValue: false, description: '是否评测 BEAM（Beyond a Million Tokens，1M 长程记忆基准，独立两阶段脚本：生成+LLM 判分；数据在仓库 LFS 内；1M 全量 700 题、单轮数小时，建议勾选后仅保留一个思考强度；需被测端点支持 ~1M token 上下文）')
        choice(name: 'BEAM_DATA', choices: ['1m', '128k'], description: 'BEAM 数据规格（1m=35 段对话×20 题=700 题，单题上下文可达 1M；128k=128k token 对话变体，用于上下文窗口不足 1M 的部署）')
        booleanParam(name: 'BEAM_PLAIN_TEXT', defaultValue: true, description: 'BEAM 历史渲染模式（true=plain-text 单消息拼接，与上游 CI 默认一致；false=保留多轮 messages）')
        string(name: 'BEAM_CONCURRENCY', defaultValue: '8', description: 'BEAM 生成阶段并发请求数（1M prompt 较重，SGLang 自部署建议 4~8）')
        string(name: 'BEAM_TIMEOUT', defaultValue: '3600', description: 'BEAM 生成阶段单请求超时秒数（1M prompt + 长思考生成较慢，默认 3600）')
        booleanParam(name: 'BEAM_DRY_RUN', defaultValue: false, description: 'BEAM 冒烟模式（仅构建 prompt 不发请求，用于验证数据与上下文预算配置；自动跳过判分与汇总，不出结果行）')
        string(name: 'JUDGE_BASE_URL', defaultValue: '', description: 'BEAM 判分端点根地址（带 /v1；空=仅生成答案跳过判分与汇总；判分走 LLM-as-Judge，须与被测端点独立、Jenkins 节点可直连）')
        password(name: 'JUDGE_API_KEY', defaultValue: '', description: 'BEAM 判分端点 API Key（JUDGE_BASE_URL 非空时必填）')
        string(name: 'JUDGE_MODEL', defaultValue: 'kimi-k2.6', description: 'BEAM 判分模型（上游 CI 默认 kimi-k2.6；kimi 系判分模型须配合 JUDGE_TEMPERATURE=1.0）')
        string(name: 'JUDGE_TEMPERATURE', defaultValue: '1.0', description: '判分模型采样温度（kimi 系判分模型锁定 1.0；其他模型可用 0.3）')
        string(name: 'JUDGE_CONCURRENCY', defaultValue: '10', description: '判分并发请求数（默认 10，与上游 CI 一致）')

        choice(name: 'THINK_MODE', choices: ['kimi', 'opensource'], description: 'thinking 参数格式（kimi=官方 API 格式；opensource=vLLM/SGLang 等开源部署格式，默认 kimi）')

        // 思考强度：多选组合，每个勾选的强度都会对每个勾选的评测任务各跑一轮
        booleanParam(name: 'EFFORT_NONE', defaultValue: false, description: 'reasoning_effort=none（关闭思考，即 non-thinking 轮；注意：kimi_toolcall 数据集为 thinking-only，该任务自动跳过 none 轮）')
        booleanParam(name: 'EFFORT_LOW', defaultValue: false, description: 'reasoning_effort=low')
        booleanParam(name: 'EFFORT_HIGH', defaultValue: false, description: 'reasoning_effort=high')
        booleanParam(name: 'EFFORT_MAX', defaultValue: true, description: 'reasoning_effort=max（README K3 推荐基准口径，默认勾选）')

        // 按任务配置（JSON，与 evalscope-test 流水线的 TASK_MAX_TOKENS_JSON 风格一致）：
        // 每个维度一个 JSON 参数，键 = 评测任务名，须覆盖所有勾选任务，缺失/不合法则运行评测开始时校验失败
        text(name: 'TASK_LIMIT_JSON', defaultValue: '{"ocrbench": null, "mmmu": null, "kimi_toolcall": null, "beam": null}', description: '按任务指定样本上限的 JSON。键=ocrbench/mmmu/kimi_toolcall/beam，值=null（全量）或正整数；须覆盖所有勾选任务，缺失或不合法则校验失败。全量口径：OCRBench 1000 / MMMU 约 1.17 万（单轮数亿 token，请预留充足时长）/ kimi_toolcall 70 / BEAM 700。快速验证示例：{"ocrbench": 200, "mmmu": 100, "kimi_toolcall": 70, "beam": 5}')
        text(name: 'TASK_MAX_TOKENS_JSON', defaultValue: '{"ocrbench": 16384, "mmmu": 65536, "kimi_toolcall": 32768, "beam": 65536}', description: '按任务指定单次响应最大 tokens 的 JSON（默认：OCRBench 16384 / MMMU 65536（本地口径；上游 README「Recommended Benchmark Parameters (K3)」推荐 98304，可按需覆盖）/ kimi_toolcall 32768；beam 65536 = 上游 BEAM 脚本默认）。键=评测任务名，值=正整数；须覆盖所有勾选任务，缺失或不合法则校验失败')

        // 以下默认值 = README「Recommended Benchmark Parameters (K3)」
        string(name: 'TEMPERATURE', defaultValue: '1.0', description: '采样温度（README K3 推荐值 1.0；non-thinking 轮可改 0.6）')
        string(name: 'TOP_P', defaultValue: '0.95', description: 'top_p（README 推荐 0.95）')
        string(name: 'EPOCHS', defaultValue: '1', description: '采样轮数（README 推荐 1）')
        string(name: 'MAX_CONNECTIONS', defaultValue: '8', description: '并发连接数（官方 API 为 50，SGLang 自部署建议 4~8，429 限流时降低）')
        string(name: 'CLIENT_TIMEOUT', defaultValue: '86400', description: '单请求超时秒数（长生成保活，默认 86400）')
        booleanParam(name: 'STREAM', defaultValue: true, description: '是否流式请求（长生成保活，推荐开启）')

        string(name: 'HTTP_PROXY', defaultValue: 'http://10.201.136.68:1080', description: '代理地址，仅用于 git lfs pull 与 HuggingFace 数据集首次下载（空 = 直连）；依赖安装不走代理（直连 pypi）；评测阶段自动剥离代理，模型请求全直连；数据缓存于 ~/.cache/huggingface 后不再依赖')
        string(name: 'HF_ENDPOINT', defaultValue: '', description: 'HuggingFace 镜像端点（可选，如 https://hf-mirror.com）')

        string(name: 'DESCRIPTION', defaultValue: '', description: '模型服务的描述信息（仅用于邮件展示）')
        text(name: 'RECIPIENTS', defaultValue: 'liwt@zetyun.com', description: '评测报告邮件接收者（逗号分隔）')
        string(name: 'WORK_DIR', defaultValue: '/dingofs/data2/userdata/liwt/maas-image/Kimi-Vendor-Verifier', description: '测试仓库目录，请不要改动')
    }

    environment {
        SSH_CREDENTIALS = 'HOST_SSH_KEY'
        REMOTE_HOST = '10.201.132.50'
        REMOTE_USER = 'root'
        // 与功能验证流水线(Jenkinsfile)的 builds/<tester>/<N> 完全隔离:
        // 两条流水线是独立 Jenkins job,BUILD_NUMBER 各自计数、可能相同,
        // 基准评测产物走独立命名空间,避免同号构建目录互相嵌套、混入对方
        // tar 包、或被对方"保留最近 20 个"的清理逻辑误删
        // 目录分层 bench_builds/<tester>/<model>/<build>/,model 名做文件系统安全化(与功能流水线一致)
        BUILD_OUTPUT_DIR = "bench_builds/${params.TESTER}/${params.MODEL.replaceAll('[^A-Za-z0-9._-]', '_')}/${BUILD_NUMBER}"
        // 用户在 BASE_URL 填根地址（可不带或带 /v1，可带或不带尾斜杠）。
        // 这里 idempotent 拼接出唯一的 OpenAI 兼容端点：
        //   先 trim 两端空白(粘贴时常见的尾随空格会让请求打到 "/v1 /chat/completions"
        //   这类 404 路径,#14 构建即因 JUDGE_BASE_URL 尾随空格全量判分 404)
        //   → 再剥尾斜杠 → 再剥结尾 /v1（若有）→ 统一补 /v1
        BASE_URL_V1 = "${params.BASE_URL.trim().replaceAll('/+$', '').replaceAll('/?v1$', '')}/v1"
    }

    stages {
        stage('打印评测参数') {
            steps {
                script {
                    println("========================================")
                    println("=== KVV 基准评测参数信息 ===")
                    println("========================================")
                    println("测试人员:     ${params.TESTER}")
                    println("芯片平台:     ${params.CHIP}")
                    println("推理框架:     ${params.ENGINE}")
                    println("PD分离模式:   ${params.PD}")
                    println("评测任务:     ocrbench=${params.RUN_OCRBENCH} mmmu=${params.RUN_MMMU} toolcall=${params.RUN_TOOLCALL} beam=${params.RUN_BEAM}")
                    println("模型名称:     ${params.MODEL}")
                    println("BASE_URL:     ${params.BASE_URL}  (→ ${env.BASE_URL_V1})")
                    println("ThinkMode:    ${params.THINK_MODE}")
                    println("思考强度:     none=${params.EFFORT_NONE} low=${params.EFFORT_LOW} high=${params.EFFORT_HIGH} max=${params.EFFORT_MAX}")
                    if (params.RUN_BEAM) {
                        println("BEAM:         data=${params.BEAM_DATA} plain_text=${params.BEAM_PLAIN_TEXT} dry_run=${params.BEAM_DRY_RUN} conc=${params.BEAM_CONCURRENCY} timeout=${params.BEAM_TIMEOUT}s")
                        if (params.JUDGE_BASE_URL?.trim()) {
                            println("BEAM Judge:   ${params.JUDGE_BASE_URL} (model=${params.JUDGE_MODEL}, temp=${params.JUDGE_TEMPERATURE}, conc=${params.JUDGE_CONCURRENCY})")
                        } else {
                            println("BEAM Judge:   （未配置，仅生成答案，跳过判分与汇总）")
                        }
                    }
                    println("样本上限JSON: ${params.TASK_LIMIT_JSON}")
                    println("MaxTokens JSON: ${params.TASK_MAX_TOKENS_JSON}")
                    println("温度/topP:    ${params.TEMPERATURE} / ${params.TOP_P}")
                    println("轮数:         ${params.EPOCHS}")
                    println("并发连接数:   ${params.MAX_CONNECTIONS}")
                    println("流式:         ${params.STREAM}")
                    println("代理:         ${params.HTTP_PROXY ?: '(直连)'}")
                    println("HF镜像:       ${params.HF_ENDPOINT ?: '(默认)'}")
                    println("模型描述:     ${params.DESCRIPTION ?: '(无)'}")
                    println("邮件接收者:   ${params.RECIPIENTS}")
                    println("工作目录:     ${params.WORK_DIR}")
                    println("构建编号:     #${BUILD_NUMBER}")
                    println("========================================")
                }
            }
        }

        stage('评测项校验') {
            steps {
                script {
                    def benches = []
                    if (params.RUN_OCRBENCH) { benches.add('ocrbench') }
                    if (params.RUN_MMMU) { benches.add('mmmu') }
                    if (params.RUN_TOOLCALL) { benches.add('kimi_toolcall') }
                    if (params.RUN_BEAM) { benches.add('beam') }
                    if (!benches) {
                        error("请至少勾选一个评测任务(OCRBench/MMMU/ToolCall/BEAM)")
                    }
                    def judgeApiKey = params.JUDGE_API_KEY?.toString()?.trim()
                    if (params.RUN_BEAM) {
                        if (params.JUDGE_BASE_URL?.trim() && !judgeApiKey) {
                            error("RUN_BEAM 已配置判分端点 JUDGE_BASE_URL，必须同时填写 JUDGE_API_KEY（或清空 JUDGE_BASE_URL 仅生成答案）")
                        }
                        if (!params.JUDGE_BASE_URL?.trim()) {
                            println("WARN: RUN_BEAM 未配置 JUDGE_BASE_URL，本次仅生成 answers（跳过判分与汇总，不出 accuracy 结果行）")
                        }
                    }
                    def efforts = []
                    if (params.EFFORT_NONE) { efforts.add('none') }
                    if (params.EFFORT_LOW) { efforts.add('low') }
                    if (params.EFFORT_HIGH) { efforts.add('high') }
                    if (params.EFFORT_MAX) { efforts.add('max') }
                    if (!efforts) {
                        error("请至少勾选一个思考强度(none/low/high/max)")
                    }
                    env.BENCHES = benches.join(' ')
                    env.EFFORTS = efforts.join(' ')
                    // kimi_toolcall 数据集为 thinking-only(K3 表无 non-thinking Tool Call 行),跳过 none 组合
                    def combos = []
                    for (b in benches) {
                        for (e in efforts) {
                            if (b == 'kimi_toolcall' && e == 'none') {
                                println("  - 跳过 kimi_toolcall / none (thinking-only 数据集,无 non-thinking 协议)")
                                continue
                            }
                            combos.add("${b} / ${e}")
                        }
                    }
                    if (combos.isEmpty()) {
                        error("有效评测组合为空：kimi_toolcall 不支持 effort=none，请调整勾选项")
                    }
                    println("本次将执行 ${combos.size()} 个评测组合:")
                    combos.each { println("  - ${it}") }
                    if (params.RUN_BEAM && efforts.size() > 1) {
                        println("WARN: BEAM 已勾选且选择了 ${efforts.size()} 个思考强度，BEAM 每个强度各跑一轮全量（1M 单轮数小时），请确认时长预算")
                    }
                }
            }
        }

        stage('API 连通性预检') {
            steps {
                sshagent(credentials: ["${SSH_CREDENTIALS}"]) {
                    script {
                        def apiKey = params.API_KEY?.toString()?.trim()
                        if (!apiKey) { apiKey = 'EMPTY' }
                        def judgeApiKey = params.JUDGE_API_KEY?.toString()?.trim()
                        def judgeBaseUrl = params.JUDGE_BASE_URL?.toString()?.trim()
                        try {
                            sh """
ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} << 'ENDSSH'
set -o pipefail
{
    echo "=== 检查 API 连通性 (/v1/models) ==="
    HTTP_CODE=\$(curl -s --connect-timeout 10 -m 30 -o /dev/null -w "%{http_code}" -H "Authorization: Bearer ${apiKey}" ${env.BASE_URL_V1}/models)
    if [ "\${HTTP_CODE}" != "200" ]; then
        echo "ERROR: API 连通性检查失败, HTTP状态码: \${HTTP_CODE}, URL: ${env.BASE_URL_V1}/models"
        exit 1
    fi
    echo "API /models 连通性检查通过, HTTP状态码: \${HTTP_CODE}"

    echo "=== 检查 Chat Completions 接口 ==="
    CHAT_RESP=\$(curl -s --connect-timeout 10 -m 60 -w "\\n%{http_code}" ${env.BASE_URL_V1}/chat/completions \\
        -H "Content-Type: application/json" \\
        -H "Authorization: Bearer ${apiKey}" \\
        -d '{"model":"${params.MODEL}","messages":[{"role":"user","content":"hello"}],"max_tokens":10}')
    CHAT_HTTP_CODE=\$(echo "\${CHAT_RESP}" | tail -1)
    if [ "\${CHAT_HTTP_CODE}" != "200" ]; then
        echo "ERROR: Chat Completions 接口检查失败, HTTP状态码: \${CHAT_HTTP_CODE}"
        echo "响应内容: \$(echo "\${CHAT_RESP}" | head -n -1)"
        exit 1
    fi
    echo "Chat Completions 接口检查通过, HTTP状态码: \${CHAT_HTTP_CODE}"

    if [ -n "${judgeBaseUrl}" ]; then
        echo "=== 检查 BEAM 判分端点连通性 (/models) ==="
        JUDGE_CODE=\$(curl -s --connect-timeout 10 -m 30 -o /dev/null -w "%{http_code}" -H "Authorization: Bearer ${judgeApiKey}" ${judgeBaseUrl}/models)
        if [ "\${JUDGE_CODE}" != "200" ]; then
            echo "ERROR: BEAM 判分端点检查失败, HTTP状态码: \${JUDGE_CODE}, URL: ${judgeBaseUrl}/models (URL/Key 不正确或端点不可达;注意勿带多余空格)"
            exit 1
        fi
        echo "BEAM 判分端点 /models 检查通过, HTTP状态码: \${JUDGE_CODE}"

        echo "=== 检查 BEAM 判分模型可用性 (chat/completions) ==="
        JUDGE_RESP=\$(curl -s --connect-timeout 10 -m 60 -w "\\n%{http_code}" ${judgeBaseUrl}/chat/completions \\
            -H "Content-Type: application/json" \\
            -H "Authorization: Bearer ${judgeApiKey}" \\
            -d '{"model":"${params.JUDGE_MODEL}","messages":[{"role":"user","content":"ping"}],"max_tokens":1}')
        JUDGE_CHAT_CODE=\$(echo "\${JUDGE_RESP}" | tail -1)
        if [ "\${JUDGE_CHAT_CODE}" != "200" ]; then
            echo "ERROR: BEAM 判分模型检查失败, HTTP状态码: \${JUDGE_CHAT_CODE} (判分模型 ${params.JUDGE_MODEL} 不可用或 URL/Key 不正确)"
            echo "响应内容: \$(echo "\${JUDGE_RESP}" | head -n -1)"
            exit 1
        fi
        echo "BEAM 判分模型可用性检查通过, 判分模型: ${params.JUDGE_MODEL}, HTTP状态码: \${JUDGE_CHAT_CODE}"
    fi
} 2>&1 | tee /tmp/kvv_bench_connectivity_${BUILD_NUMBER}.log
ENDSSH
"""
                        } catch (Exception e) {
                            env.CONNECTIVITY_FAILED = 'true'
                            currentBuild.result = 'UNSTABLE'
                            println("=== API 连通性预检失败,后续阶段(环境准备、运行评测、拉取结果)将跳过 ===")
                        }
                    }
                }
            }
        }

        stage('环境准备') {
            when {
                expression { env.CONNECTIVITY_FAILED != 'true' }
            }
            steps {
                sshagent(credentials: ["${SSH_CREDENTIALS}"]) {
                    sh """
ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} << 'ENDSSH'
set -e
cd ${params.WORK_DIR}
echo "工作目录: \$(pwd)"

echo "=== 清理残留评测进程 ==="
# 正向模式只匹配基准评测自身进程;排除 run_kimivv_tests 做双保险,
# 即使基准评测触发时功能验证流水线正在运行,也不会误杀其进程
RESIDUAL=\$(pgrep -af "kvv_bench_runner|run_kimivv_bench|beam_generate|beam_judge" 2>/dev/null | grep -vE "jenkins|durable|@tmp|run_kimivv_tests" || true)
if [ -n "\${RESIDUAL}" ]; then
    echo "发现残留进程:"
    echo "\${RESIDUAL}"
    echo "发送 SIGTERM..."
    echo "\${RESIDUAL}" | awk '{print \$1}' | xargs -r kill -TERM 2>/dev/null || true
    sleep 3
    REMAINING=\$(pgrep -af "kvv_bench_runner|run_kimivv_bench|beam_generate|beam_judge" 2>/dev/null | grep -vE "jenkins|durable|@tmp|run_kimivv_tests" || true)
    if [ -n "\${REMAINING}" ]; then
        echo "残留进程未响应 SIGTERM,发送 SIGKILL..."
        echo "\${REMAINING}" | awk '{print \$1}' | xargs -r kill -KILL 2>/dev/null || true
        sleep 1
    fi
    FINAL=\$(pgrep -af "kvv_bench_runner|run_kimivv_bench|beam_generate|beam_judge" 2>/dev/null | grep -vE "jenkins|durable|@tmp|run_kimivv_tests" || true)
    if [ -n "\${FINAL}" ]; then
        echo "WARN: 以下残留进程仍存在,需人工介入:"
        echo "\${FINAL}"
    else
        echo "残留进程清理完成"
    fi
else
    echo "未发现残留进程"
fi

echo "=== 同步 LFS 数据(已拉取的对象自动跳过) ==="
PROXY="${params.HTTP_PROXY}"
# 占位符未替换(值含 '<')时按直连处理
case "\${PROXY}" in *'<'*) PROXY="" ;; esac
if [ -n "\${PROXY}" ]; then
    export https_proxy="\${PROXY}"
    export http_proxy="\${PROXY}"
    echo "proxy enabled for lfs pull: \${PROXY}"
else
    echo "lfs pull 直连(HTTP_PROXY 为空或占位符未替换)"
fi
if command -v git-lfs >/dev/null 2>&1; then
    git lfs pull
else
    echo "警告: git-lfs 不可用，OCRBench/MMMU 为 HF 在线数据集不受影响，kimi_toolcall 与 BEAM 数据集可能缺失"
fi
unset https_proxy
unset http_proxy

echo "=== 检查并创建虚拟环境 ==="
if [ ! -d ".venv" ]; then
    echo "虚拟环境不存在，创建虚拟环境..."
    uv venv
fi
