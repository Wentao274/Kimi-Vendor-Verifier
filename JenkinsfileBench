<p>Jenkins 构建地址: <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
<div class="email-footer">此邮件由 Jenkins 自动发送，请勿回复。</div>
</body>
</html>"""

                        emailext(
                            subject: "[KVV 基准评测] ${params.MODEL} - ${benchList ?: '无评测任务'} - 构建 #${BUILD_NUMBER} - ${currentBuild.currentResult}",
                            body: emailBody,
                            to: "${params.RECIPIENTS}",
                            mimeType: 'text/html',
                            attachmentsPattern: "reports/${BUILD_NUMBER}/bench/**/bench_*.log,reports/${BUILD_NUMBER}/bench/bench_summary.properties,reports/${BUILD_NUMBER}/bench/*_kvv_bench_test_report*.html,reports/${BUILD_NUMBER}/bench_run_${BUILD_NUMBER}.log"
                        )
                    }
                }
            }
        }

        stage('清理旧构建') {
            steps {
                sshagent(credentials: ["${SSH_CREDENTIALS}"]) {
                    sh """
ssh -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} << 'ENDSSH'
cd ${params.WORK_DIR}/bench_builds/${params.TESTER} 2>/dev/null || exit 0
# 目录层级为 <model>/<build_number>/:每个模型目录内只保留最近 20 个构建,清空的模型目录移除
for MODEL_DIR in */ ; do
    if [ -d "\$MODEL_DIR" ]; then
        ( cd "\$MODEL_DIR" 2>/dev/null && ls -t | tail -n +21 | xargs -r rm -rf )
        rmdir "\$MODEL_DIR" 2>/dev/null || true
    fi
done
ENDSSH"""
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: "reports/${env.BUILD_NUMBER}/**", allowEmptyArchive: true, fingerprint: true
        }
        cleanup {
            cleanWs()
        }
    }
}
